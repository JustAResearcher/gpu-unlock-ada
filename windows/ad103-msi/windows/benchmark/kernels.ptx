    ret;
}

.visible .entry bench_scalar_fp32(
    .param .u32 iterations,
    .param .u64 output,
    .param .b32 input_bits
)
{
    .reg .pred %p;
    .reg .b32 %i, %n, %thread_idx, %bid, %bdim, %idx, %a, %grid, %cells;
    .reg .b64 %out, %offset, %address, %stride;
    .reg .f32 %f<32>, %sum, %one;
    ld.param.u32 %n, [iterations];
    ld.param.u64 %out, [output];
    mov.u32 %i, 0;
    mov.f32 %f0, 0f00000000;
    mov.f32 %f1, 0f3f800000;
    mov.f32 %f2, 0f40000000;
    mov.f32 %f3, 0f40400000;
    mov.f32 %f4, 0f40800000;
    mov.f32 %f5, 0f40a00000;
    mov.f32 %f6, 0f40c00000;
    mov.f32 %f7, 0f40e00000;
    ld.param.f32 %one, [input_bits];
    setp.eq.u32 %p, %n, 0;
    @%p bra DONE;
LOOP:
    fma.rn.f32 %f0, %one, %one, %f0;
    fma.rn.f32 %f1, %one, %one, %f1;
    fma.rn.f32 %f2, %one, %one, %f2;
    fma.rn.f32 %f3, %one, %one, %f3;
    fma.rn.f32 %f4, %one, %one, %f4;
    fma.rn.f32 %f5, %one, %one, %f5;
    fma.rn.f32 %f6, %one, %one, %f6;
    fma.rn.f32 %f7, %one, %one, %f7;
    add.u32 %i, %i, 1;
    setp.lt.u32 %p, %i, %n;
    @%p bra LOOP;
DONE:
    mov.u32 %thread_idx, %tid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %bdim, %ntid.x;
    mad.lo.u32 %idx, %bid, %bdim, %thread_idx;
    mul.wide.u32 %offset, %idx, 4;
    add.u64 %address, %out, %offset;
    mov.u32 %grid, %nctaid.x;
    mul.lo.u32 %cells, %grid, %bdim;
    mul.wide.u32 %stride, %cells, 4;
    st.global.f32 [%address], %f0;
    add.u64 %address, %address, %stride;
    st.global.f32 [%address], %f1;
    add.u64 %address, %address, %stride;
    st.global.f32 [%address], %f2;
    add.u64 %address, %address, %stride;
    st.global.f32 [%address], %f3;
    add.u64 %address, %address, %stride;
    st.global.f32 [%address], %f4;
    add.u64 %address, %address, %stride;
    st.global.f32 [%address], %f5;
    add.u64 %address, %address, %stride;
    st.global.f32 [%address], %f6;
    add.u64 %address, %address, %stride;
    st.global.f32 [%address], %f7;
    ret;
}
