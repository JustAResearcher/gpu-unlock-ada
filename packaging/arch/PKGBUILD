# SPDX-License-Identifier: GPL-2.0-only
# Builds from the committed HEAD of the checkout this file lives in:
#   cd packaging/arch && makepkg -si
# For a published release, point the first source at the tagged tarball.
pkgbase=gpu-unlock
pkgname=(gpu-unlock-dkms gpu-unlock-firmware)
pkgver=1.1.1
pkgrel=1
_nv=610.43.03
_utils=nvidia-utils-$_nv-1-x86_64.pkg.tar.zst
pkgdesc='RTX 4090 and experimental Ada tensor unlock before NVIDIA loads'
arch=('x86_64')
url='https://github.com/JustAResearcher/gpu-unlock-ada'
license=('GPL-2.0-only')
makedepends=('git' 'python' 'zstd')
options=('!strip' '!debug')
source=("$pkgbase::git+file://${startdir%/packaging/arch}"
        "https://download.nvidia.com/XFree86/NVIDIA-kernel-module-source/NVIDIA-kernel-module-source-$_nv.tar.xz"
        "https://archive.archlinux.org/packages/n/nvidia-utils/$_utils")
noextract=("$_utils")
sha256sums=('SKIP'
            '7e118923c7a23edc36114d63273a46e3e04e9af98695a42203e7ac2dfe9fc1dc'
            'c3367ff68632ac7daf6ca50ef7cbdd1cb5d09f7fe0b26125b312c73e52a34cf4')

prepare() {
  cd $pkgbase
  test "$(cat VERSION)" = "$pkgver"
}

build() {
  cd $pkgbase
  python firmware/generate_v67.py "$(realpath "$srcdir/$_utils")" "$srcdir/assets"
  python firmware/extract_boot_assets.py "$srcdir/NVIDIA-kernel-module-source-$_nv" "$srcdir/assets"
  python firmware/extract_boot_assets.py "$srcdir/NVIDIA-kernel-module-source-$_nv" "$srcdir/assets" --chip ad102
}

check() {
  cd $pkgbase
  make test-full ASSETS="$srcdir/assets" NVIDIA_SOURCE="$srcdir/NVIDIA-kernel-module-source-$_nv"
}

package_gpu-unlock-dkms() {
  arch=('any')
  depends=('dkms' "gpu-unlock-firmware=$pkgver-$pkgrel")
  backup=('etc/mkinitcpio.conf.d/zz-gpu-unlock.conf')
  conflicts=('gpu-unlock-mkinitcpio')
  replaces=('gpu-unlock-mkinitcpio')
  install=gpu-unlock.install
  cd $pkgbase
  make DESTDIR="$pkgdir" install-dkms install-mkinitcpio install-dracut
  make DESTDIR="$pkgdir" PKG=$pkgname install-licenses
}

package_gpu-unlock-firmware() {
  pkgdesc='Locally generated, pinned NVIDIA 610.43.03 firmware assets for gpu-unlock'
  license=('LicenseRef-NVIDIA' 'GPL-2.0-only')
  cd $pkgbase
  make DESTDIR="$pkgdir" ASSETS="$srcdir/assets" install-firmware
}
